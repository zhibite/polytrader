# ─── Trader Strategy Lab ────────────────────────────────────────────────────
# All application settings use the LAB_ prefix.

# Storage. Local runs use ./data; Docker/compose overrides this to /app/data.
LAB_DATA_DIR=./data
LAB_DB_PATH=./data/lab.sqlite

# The wallet this lab is built around.
LAB_TARGET_ADDRESS=0xcd30457c790d8b35a08bcf3f894ad6bb52bc2dd0

# Historical ingest defaults.
LAB_DEFAULT_WINDOW_DAYS=30
LAB_INGEST_MAX_TRADES=130000
LAB_ENRICH_MAX_TRADES=40000
LAB_ENRICH_DAYS=14
LAB_REQUEST_RATE=2.5
LAB_KLINE_RATE=5.0

# Read the existing 1-second kline dataset when it is mounted (optional).
# The dataset layout is asset=btc/period=5m/date=YYYY-MM-DD/klines.csv.gz
LAB_KLINES_DATASET_DIR=

# Live collector. Needs outbound access to gamma-api / ws-subscriptions-clob.
LAB_COLLECTOR_ENABLED=1
LAB_COLLECTOR_ASSET=btc
LAB_COLLECTOR_INTERVAL=5
LAB_TARGET_POLL_SECONDS=20

# Periodic monitoring snapshots (hours). 0 disables the scheduler.
LAB_MONITOR_INTERVAL_HOURS=6
LAB_MONITOR_WINDOW_DAYS=7

# Set to 1 to seed a small synthetic dataset on an empty database (local UI work).
LAB_DEMO_SEED=0

# Public Polymarket endpoints.
LAB_API_BASE=https://data-api.polymarket.com/v2
LAB_GAMMA_BASE=https://gamma-api.polymarket.com
LAB_CLOB_BASE=https://clob.polymarket.com
LAB_CLOB_WS=wss://ws-subscriptions-clob.polymarket.com/ws/market
LAB_FUTURE_NEWS_BASE=https://future.news/api/v1

# UI
LAB_TIMEZONE=UTC

# Optional HTTP Basic Auth for a public deployment. If both are set, every
# route except /api/health requires credentials.
LAB_BASIC_AUTH_USER=
LAB_BASIC_AUTH_PASSWORD=
