# ─── Trader Strategy Lab ────────────────────────────────────────────────────
# All application settings use the LAB_ prefix.

# Storage. Local runs use ./data; Docker/compose overrides this to /app/data.
LAB_DATA_DIR=./data
LAB_DB_PATH=./data/lab.sqlite

# The wallet this lab is built around.
LAB_TARGET_ADDRESS=0xcd30457c790d8b35a08bcf3f894ad6bb52bc2dd0

# Historical ingest defaults.
LAB_DEFAULT_WINDOW_DAYS=30
LAB_INGEST_MAX_TRADES=130000
LAB_ENRICH_MAX_TRADES=40000
LAB_ENRICH_DAYS=14
LAB_REQUEST_RATE=2.5
LAB_KLINE_RATE=5.0

# Read the existing 1-second kline dataset when it is mounted (optional).
# The dataset layout is asset=btc/period=5m/date=YYYY-MM-DD/klines.csv.gz
LAB_KLINES_DATASET_DIR=

# Live collector. Needs outbound access to gamma-api / ws-subscriptions-clob.
LAB_COLLECTOR_ENABLED=1
LAB_COLLECTOR_ASSET=btc
LAB_COLLECTOR_INTERVAL=5
LAB_TARGET_POLL_SECONDS=20

# Periodic monitoring snapshots (hours). 0 disables the scheduler.
LAB_MONITOR_INTERVAL_HOURS=6
LAB_MONITOR_WINDOW_DAYS=7

# Automated research pipeline: every N hours -> ingest -> 3 sweep rounds
# -> save best config -> activate forward paper trading.
LAB_AUTO_PIPELINE_HOURS=6
LAB_AUTO_PIPELINE_DAYS=7
LAB_AUTO_PIPELINE_ROUNDS=3
LAB_AUTO_PIPELINE_TOP_K=8
LAB_AUTO_PIPELINE_MAX_COST_PER_MARKET=25
LAB_AUTO_PIPELINE_MAX_OPEN_COST=500

# Forward paper trading (live collector, no real orders).
LAB_PAPER_ENABLED=1
LAB_PAPER_TICK_SECONDS=10
LAB_PAPER_STARTING_BALANCE=500
# Only replace the active paper strategy after this retention and with
# a validation ROI lead of at least the margin.
LAB_PAPER_MIN_RETENTION_HOURS=24
LAB_PAPER_MIN_SETTLED_TRADES=100
LAB_PAPER_PROMOTION_MARGIN=0.01

# Set to 1 to seed a small synthetic dataset on an empty database (local UI work).
LAB_DEMO_SEED=0

# Public Polymarket endpoints.
LAB_API_BASE=https://data-api.polymarket.com/v2
LAB_GAMMA_BASE=https://gamma-api.polymarket.com
LAB_CLOB_BASE=https://clob.polymarket.com
LAB_CLOB_WS=wss://ws-subscriptions-clob.polymarket.com/ws/market
LAB_FUTURE_NEWS_BASE=https://future.news/api/v1

# UI
LAB_TIMEZONE=UTC

# Container listen ports. 8021 is primary; 8000 stays as a compatibility
# fallback for a stale Coolify/Traefik port. Set to "8021" to bind only 8021.
LAB_BIND_PORTS=8021,8000

# Web login for a public deployment. If both are set, browsers are redirected
# to /login; scripts/API can still use the same credentials via HTTP Basic Auth.
# LAB_BASIC_AUTH_USER / LAB_BASIC_AUTH_PASSWORD remain supported as a fallback.
LAB_AUTH_USER=
LAB_AUTH_PASSWORD=

# Signs the session cookie. Set a long random value in production; if empty it
# is derived from the login password (sessions reset when the password changes).
LAB_SESSION_SECRET=
# Set to 1 when the app is only reachable through HTTPS.
LAB_COOKIE_SECURE=0
